{
  "manifest_version": 3,
  "name": "StreamerIsolate",
  "version": "0.1.0",
  "description": "Removes background music from a livestream, keeping only speech. Drives the StreamerIsolate backend.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.twitch.tv/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8765 ws://localhost:8765"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "StreamerIsolate",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "streamerisolate@angusa1210.github.io",
      "strict_min_version": "128.0"
    }
  }
}
