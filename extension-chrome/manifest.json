{
  "manifest_version": 3,
  "name": "StreamerIsolate",
  "version": "0.7.0",
  "description": "Removes background music from a livestream tab's audio via a local Demucs backend, keeping only speech.",
  "key": "",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StreamerIsolate",
    "default_popup": "popup.html"
  }
}
